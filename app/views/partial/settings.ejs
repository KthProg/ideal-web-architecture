<settings-panel>
    <div class="settings-panel">
        <h2 class="settings-panel__heading">Settings</h2>
        <form class="settings-panel__form">
            <div class="settings-panel__field">
                <label class="settings-panel__label" for="notes-location">Notes Location</label>
                <input
                    class="settings-panel__input"
                    type="text"
                    id="notes-location"
                    name="notesLocation"
                    placeholder="Leave empty to use server default"
                />
            </div>
            <button class="settings-panel__save" type="submit">Save</button>
        </form>
    </div>
</settings-panel>
