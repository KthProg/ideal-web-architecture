<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>
    <%= title %>
  </title>
  <script src="public/htmx.js"></script>
  <link rel="stylesheet" href="public/styles/main.css" />
</head>

<body class="layout-app">
  <aside class="layout-app__sidebar">
    <button hx-post="/files" hx-target="#files-list" hx-swap="innerHTML">
      Create Random File
    </button>
    <button hx-get="/files" hx-target="#files-list" hx-swap="innerHTML">
      Refresh Files
    </button>
    <section id="files-list">
      <%- content %>
    </section>
  </aside>
  <main class="layout-app__content">
    <section id="file-content">

    </section>
  </main>
</body>

</html>