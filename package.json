{
  "name": "ideal-web-architecture",
  "type": "module",
  "version": "1.0.0",
  "description": "My ideal web architecture: HTMX and web components running on Node",
  "homepage": "https://github.com/KthProg/ideal-web-architecture#readme",
  "bugs": {
    "url": "https://github.com/KthProg/ideal-web-architecture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KthProg/ideal-web-architecture.git"
  },
  "license": "ISC",
  "author": "Kyle Hooks",
  "main": "index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "detect-character-encoding",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx --watch app/server.ts",
    "build": "cp node_modules/htmx.org/dist/htmx.js app/public/htmx.js && esbuild app/components/*.ts app/helpers/config.ts --bundle --format=esm --outbase=app --outdir=app/public",
    "watch:components": "esbuild app/components/*.ts app/helpers/config.ts --bundle --format=esm --outbase=app --outdir=app/public --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "detect-character-encoding": "^0.9.0",
    "ejs": "^6.0.1",
    "file-type": "^22.1.1",
    "htmx.org": "2.0.11",
    "iconv-lite": "^0.7.3",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@types/detect-character-encoding": "^0.7.2",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "parcel": "^2.16.4",
    "tsx": "^4.23.15"
  }
}
